NEXT_PUBLIC_API_MODE=direct
NEXT_PUBLIC_ZEROQ_API_URL=http://localhost:20180
NEXT_PUBLIC_AUTH_API_URL=http://localhost:9000
NEXT_PUBLIC_CLIENT_ID=zeroq-front-admin

# Optional separate admin API. When omitted, NEXT_PUBLIC_ZEROQ_API_URL is reused.
# NEXT_PUBLIC_ADMIN_API_URL=http://localhost:20180

# Cloud Gateway/Eureka mode
# NEXT_PUBLIC_API_MODE=gateway
# NEXT_PUBLIC_API_URL=http://localhost:8080
# The explicit service/auth URLs above take precedence. Replace BOTH when switching:
# NEXT_PUBLIC_ZEROQ_API_URL=http://localhost:8080
# NEXT_PUBLIC_AUTH_API_URL=http://localhost:8080
